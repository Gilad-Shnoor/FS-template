{
  "$schema": "./stack.schema.json",
  "project": "fs-template",
  "kubeContext": "docker-desktop",
  "addons": {
    "redis": { "enabled": false },
    "rabbitmq": { "enabled": false }
  },
  "services": {
    "web": {
      "template": "web",
      "public": "app.localhost",
      "routes": { "/api": "api" }
    },
    "api": {
      "template": "http",
      "public": "api.localhost",
      "db": "own",
      "uses": [],
      "calls": [],
      "replicas": 1,
      "env": {
        "AUTH_ENABLED": "true",
        "BETTER_AUTH_URL": "http://app.localhost",
        "BETTER_AUTH_SECRET": "local-dev-only-secret-change-me-0123456789",
        "TRUSTED_ORIGINS": "http://app.localhost,http://api.localhost",
        "CORS_ORIGINS": "http://app.localhost"
      }
    }
  }
}
