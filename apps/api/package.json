{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --inspect=0.0.0.0:9229 src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/cli.ts latest",
    "db:rollback": "tsx src/db/cli.ts rollback",
    "db:status": "tsx src/db/cli.ts status",
    "db:make": "tsx src/db/cli.ts make",
    "db:seed": "tsx src/db/cli.ts seed"
  },
  "dependencies": {
    "@app/contracts": "*",
    "@app/server-kit": "*",
    "better-auth": "^1.3.7",
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "vitest": "^5.0.3"
  }
}
